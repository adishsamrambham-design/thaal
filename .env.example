# Copy this file to .env.local and fill in values. NEVER commit .env.local.
# Values below are placeholders. For local development, `pnpm db:start` prints the real local values.

# Public (visible in the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME_WITH_LOCAL_KEY

# Server only (never prefix with NEXT_PUBLIC_)
# Bypasses database security rules. Only needed from Phase 2.
SUPABASE_SECRET_KEY=
